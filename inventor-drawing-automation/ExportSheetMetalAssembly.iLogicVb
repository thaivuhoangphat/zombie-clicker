Class Logger
    Shared Sub Info(msg As String)
        Trace.WriteLine("[iLogic][INFO] " & msg)
    End Sub
    Shared Sub Warn(msg As String)
        Trace.WriteLine("[iLogic][WARN] " & msg)
    End Sub
    Shared Sub [Error](msg As String)
        Trace.WriteLine("[iLogic][ERR ] " & msg)
    End Sub
End Class

